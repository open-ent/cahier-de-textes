<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fr.openent</groupId>
        <artifactId>app-parent</artifactId>
        <version>1.2.0</version>
    </parent>
    <groupId>fr.openent</groupId>
    <artifactId>diary</artifactId>
    <version>4.2.4-patched</version>
    <scm>
        <connection>scm:git:https://github.com/OPEN-ENT-NG/cahier-de-textes.git</connection>
        <developerConnection>scm:git:https://github.com/OPEN-ENT-NG/cahier-de-textes.git</developerConnection>
        <url>https://github.com/OPEN-ENT-NG/cahier-de-textes</url>
    </scm>
    <repositories>
        <repository>
            <id>ode</id>
            <name>ODE Repository</name>
            <url>https://maven.opendigitaleducation.com/nexus/content/groups/public/</url>
        </repository>
        <repository>
            <id>ossrh</id>
            <url>https://oss.sonatype.org/content/repositories/snapshots</url>
        </repository>
        <repository>
            <id>ossvrtx</id>
            <url>https://oss.sonatype.org/content/repositories/iovertx-3720/</url>
        </repository>
      <repository>
        <id>pt-releases</id>
        <name>rct-nexus maven-releases (entcore-libs patchées)</name>
        <url>https://rct-nexus.tech.fr/repository/maven-releases/</url>
      </repository>
    </repositories>
    <properties>
        <toolsVersion>2.0.0-final</toolsVersion>
        <junitVersion>4.10</junitVersion>
        <powerMockVersion>2.0.2</powerMockVersion>
        <mockitoVersion>2.28.2</mockitoVersion>
        <entCoreVersion>6.16.14-patched</entCoreVersion>
        <entCoreLibsVersion>6.16.8-patched</entCoreLibsVersion>
        <gatlingHighchartsVersion>2.2.2</gatlingHighchartsVersion>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
            <version>${vertxVersion}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.entcore</groupId>
            <artifactId>common</artifactId>
            <version>${entCoreLibsVersion}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-unit</artifactId>
            <version>${vertxVersion}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockitoVersion}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.powermock</groupId>
            <artifactId>powermock-core</artifactId>
            <version>${powerMockVersion}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.powermock</groupId>
            <artifactId>powermock-module-junit4</artifactId>
            <version>${powerMockVersion}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.gatling.highcharts</groupId>
            <artifactId>gatling-charts-highcharts</artifactId>
            <version>${gatlingHighchartsVersion}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Depuis le JDK 23, javac n'exécute plus les processeurs d'annotations trouvés sur le
                 classpath : sans -proc:full, le jar part sans securedaction/ ni routes/ (404 sur
                 toutes les routes sécurisées). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-proc:full</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Mockito 2 / PowerMock inspectent par réflexion des classes du JDK ; depuis
                        JDK 17 le module java.base ne les ouvre plus au classpath, et les tests
                        échouaient d'emblée en InaccessibleObjectException. Les paquets listés sont
                        ceux que la suite atteint réellement.
                    -->
                    <argLine>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.util.stream=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            org.entcore:tests ne fournit QUE les scénarios Gatling/Scala (src/test/scala/**),
            jamais joués en CI. Depuis le 08/09/2026, le module `tests` d'entcore est exclu de la
            publication du fork (open-ent/entcore-v2, commit 275a060 : maven-scala-plugin 2.15.2 ne
            compile plus Scala 2.12 sous JDK 21), donc org.entcore:tests:*-patched n'existe plus.
            Maven résout les dépendances de portée `test` même avec -Dmaven.test.skip=true : laissée
            dans <dependencies>, elle faisait échouer `mvn package` (donc toute la CI).
            `mvn -Pgatling-it ...` pour la réactiver le jour où l'artefact sera republié.
        -->
        <profile>
            <id>gatling-it</id>
            <dependencies>
                <dependency>
                    <groupId>org.entcore</groupId>
                    <artifactId>tests</artifactId>
                    <version>${entCoreVersion}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
